                                <div class="carousel-item active" style="height: 380px;">
                                    <img src="/images/Profile.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Profile" onerror="this.src='https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?w=600'">
                                </div>
                                <div class="carousel-item" style="height: 380px;">
