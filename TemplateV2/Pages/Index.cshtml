@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Mohammad Jouhari — .NET Core & Web Developer</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/favicon.png" sizes="128x128">
    <meta name="robots" content="index, follow">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #0b0f19;
                color: #94a3b8;
                overflow-x: hidden;
            }

            h1, h2, h3, h4, h5, h6 {
                color: #f8fafc;
            }

            .navbar {
                background-color: rgba(11, 15, 25, 0.9) !important;
                backdrop-filter: blur(10px);
                border-bottom: 1px solid #1e293b;
            }

            .navbar-brand img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                object-fit: cover;
            }

            .hero-section {
                padding: 140px 0 80px 0;
                background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.15), transparent 40%);
            }

            .btn-primary {
                background-color: #2563eb;
                border-color: #2563eb;
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.3s ease;
            }

                .btn-primary:hover {
                    background-color: #1d4ed8;
                    border-color: #1d4ed8;
                    transform: translateY(-2px);
                }

            .btn-outline-light, .btn-outline-primary {
                font-weight: 500;
                border-radius: 8px;
                transition: all 0.3s ease;
            }

                .btn-outline-light:hover, .btn-outline-primary:hover {
                    transform: translateY(-2px);
                }

            .card-custom {
                background-color: #1e293b;
                border: 1px solid #334155;
                border-radius: 12px;
                transition: transform 0.3s ease, border-color 0.3s ease;
                height: 100%;
            }

                .card-custom:hover {
                    transform: translateY(-5px);
                    border-color: #2563eb;
                }

            .project-img-wrapper {
                height: 180px;
                overflow: hidden;
                border-top-left-radius: 12px;
                border-top-right-radius: 12px;
                background-color: #0f172a;
            }

                .project-img-wrapper img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.3s ease;
                }

            .card-custom:hover .project-img-wrapper img {
                transform: scale(1.05);
            }

            .badge-tech {
                background-color: rgba(37, 99, 235, 0.1);
                color: #60a5fa;
                border: 1px solid rgba(37, 99, 235, 0.2);
                font-weight: 500;
                padding: 4px 10px;
                border-radius: 6px;
                font-size: 0.75rem;
            }
            /* Footer Custom Styling to ensure visibility */
            footer {
                background-color: #070a12;
                border-top: 1px solid #1e293b;
                color: #cbd5e1 !important;
            }

                footer p, footer li, footer span, footer a {
                    color: #cbd5e1 !important;
                }

                    footer a:hover {
                        color: #60a5fa !important;
                    }
    </style>
</head>
<body dir="ltr">

    <!-- Header / Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                    <img src="/images/MJ2.jpg" alt="Mohammad Jouhari" onerror="this.src='https://via.placeholder.com/40'">
                    <span class="fw-bold text-white">Mohammad<span class="text-primary">.dev</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center gap-3">
                        <li class="nav-item"><a class="nav-link active text-white" href="#">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="#services">Services</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="#works">Works</a></li>
                        <li class="nav-item">
                            <a target="_blank" href="/CV/Mohammad_Jouhari_ATS_Resume.pdf" class="btn btn-outline-light btn-sm px-3 py-2">
                                <i class="fas fa-file-pdf me-1"></i> Download CV
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="btn btn-outline-secondary btn-sm dropdown-toggle text-light px-3 py-2" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-globe me-1"></i> English
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><a class="dropdown-item" href="#">عربي</a></li>
                                <li><a class="dropdown-item" href="#">English</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

