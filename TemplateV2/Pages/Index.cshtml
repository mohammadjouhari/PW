    <style>
        .owl-item {
            background-color: gray;
            text-align: center;
        }
        .owl-intro .item img {
            background-size: cover !important;
            background-position: initial !important;
            height: 100%;
        }
        .owl-item .item {
            background-size: cover !important;
            background-position: initial !important;
            height: 50vw;
            min-height: 500px;
            max-height: 70vh;
        }
        @@media (min-width: 1400px) {
            .owl-dots {
                position: relative !important;
                height: 73px !important;
                border-top-right-radius: 4px;
                border-bottom-right-radius: 4px
            }
        }
        @@media (min-width: 600px) {
            .owl-dots {
                position: relative !important;
                height: 54px !important;
                border-top-right-radius: 4px;
                border-bottom-right-radius: 4px
            }
        }
        #services img {
            max-width: fit-content !important;
        }
        #calender img {
            max-width: fit-content !important;
        }
        .new-box .bg {
    width: 100%;
    display: block;
    overflow: hidden;
}

/* Force images to scale fluidly without disappearing or overflowing */
.new-box .bg img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
}

@@media only screen and (max-width: 600px) {
    .new-box {
        height: auto !important;
        min-height: 200px;
        overflow: visible !important;
    }

    .new-box .bg {
        position: relative !important;
        width: 100% !important;
        height: auto !important;
        display: block !important;
    }

    .new-box .bg img {
        width: 100% !important;
        height: auto !important;
        max-height: 250px;
        object-fit: cover;
        display: block !important;
    }
}

    </style>
